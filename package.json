{
  "name": "dsh-plugin-github",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: bind a GitHub account, then let the agent clone, read, edit, commit and push repositories.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools.js",
    "./store": "./src/store.js",
    "./prompt": "./src/prompt.js",
    "./git": "./src/git.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/git.test.mjs && node test/plugin.test.mjs && node test/account.test.mjs && node test/output-contract.test.mjs && node scripts/verify-registration.mjs",
    "test:git": "node test/git.test.mjs",
    "test:plugin": "node test/plugin.test.mjs",
    "test:account": "node test/account.test.mjs",
    "test:output": "node test/output-contract.test.mjs",
    "verify": "node scripts/verify-registration.mjs && node scripts/validate-manifest.mjs",
    "verify:registration": "node scripts/verify-registration.mjs",
    "verify:manifest": "node scripts/validate-manifest.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liufangrui1105/dsh-plugin-github.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "git"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
